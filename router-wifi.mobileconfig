<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDescription</key>
            <string>Configures Wi-Fi, manual IP, and router DNS for Router network</string>
            <key>PayloadDisplayName</key>
            <string>Router Wi-Fi Static IP &amp; Router DNS</string>
            <key>PayloadIdentifier</key>
            <string>com.example.wifi.profile</string>
            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-E5F6-7890-ABCD-EF0123456789</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            
            <!-- Network Credentials -->
            <key>SSID_STR</key>
            <string>Router</string>
            <key>HIDDEN_NETWORK</key>
            <false/>
            <key>AutoJoin</key>
            <true/>
            <key>EncryptionType</key>
            <string>Any</string>
            <key>Password</key>
            <string>PassWord</string>
            
            <!-- Manual IP Configuration Settings -->
            <key>IPv4AddressMethod</key>
            <string>Manual</string>
            <key>IPv4ManualAddress</key>
            <string>192.168.</string>
            <key>IPv4ManualSubnetMask</key>
            <string>255.255.255.0</string>
            <key>IPv4ManualRouter</key>
            <string>192.168.</string>
            
            <!-- DNS Configuration Settings using Router IP -->
            <key>IPv4</key>
            <dict>
                <key>OverridePrimary</key>
                <integer>1</integer>
                <key>DNSAddresses</key>
                <array>
                    <string>192.168.</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>Home Network Static Wi-Fi Profile</string>
    <key>PayloadIdentifier</key>
    <string>com.example.profile.owner</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>12345678-ABCD-EF01-2345-6789ABCDEF01</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
