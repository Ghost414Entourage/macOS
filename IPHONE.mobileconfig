<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadDisplayName</key>
    <string>Combined Security and Privacy Restrictions</string>
    <key>PayloadDescription</key>
    <string>Disables remote screen observation, Apple personalized advertising, activity continuation (Handoff), diagnostic submissions, Siri/Assistant, forces AirDrop to be unmanaged, limits ad tracking, sets rating region to US, forces on-device only dictation, and disables Apple Intelligence Report.</string>
    <key>PayloadIdentifier</key>
    <string>com.company.profile.securityrestrictions.v9</string>
    <key>PayloadOrganization</key>
    <string>Custom IT</string>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>2B3C4D5E-6F7A-8901-BCDE-F234567890AB</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

    <!-- Payload Array -->
