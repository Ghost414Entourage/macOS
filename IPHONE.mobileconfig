            <key>PayloadUUID</key>
            <string>09876543-FEDC-BA98-7654-3210FEDCBA98</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>allowApplePersonalizedAdvertising</key>
            <false/>
        </dict>
        <dict>
            <key>PayloadDisplayName</key>
            <string>Handoff Restriction</string>
            <key>PayloadIdentifier</key>
            <string>com.company.applicationaccess.handoff</string>
