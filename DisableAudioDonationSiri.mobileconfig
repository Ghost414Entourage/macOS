<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadIdentifier</key>
    <string>com.custom.disableaudiodonationsiri</string>
    <key>PayloadUUID</key>
    <string>9A8B7C6D-5E4F-3210-9876-543210FEDCBA</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Disable Siri Audio Donation for Accessibility</string>
    <key>PayloadDescription</key>
    <string>Disables sending audio recordings to Apple to improve Accessibility Siri features.</string>
    <key>PayloadOrganization</key>
    <string>Custom IT</string>
    
    <!-- Profile Scope -->
    <key>PayloadScope</key>
    <string>System</string>
    
    <!-- Payload Array -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Accessibility Payload Domain -->
            <key>PayloadType</key>
            <string>com.apple.Accessibility</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.disableaudiodonationsiri.accessibility</string>
            <key>PayloadUUID</key>
            <string>12345678-90AB-CDEF-1234-567890ABCDEF</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Accessibility Settings</string>
            
            <!-- Target Key Setting -->
            <key>AXSAudioDonationSiriImprovementEnabled</key>
            <false/>
        </dict>
    </array>
</dict>
</plist>
