<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadIdentifier</key>
    <string>com.custom.disablemediasharing</string>
    <key>PayloadUUID</key>
    <string>C3D4E5F6-7890-ABCD-EF12-34567890ABCD</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Disable Media Sharing</string>
    <key>PayloadDescription</key>
    <string>Disables Media Sharing and prevents modifications to Media Sharing settings.</string>
    <key>PayloadOrganization</key>
    <string>Custom IT</string>
    
    <!-- Profile Scope -->
    <key>PayloadScope</key>
    <string>System</string>
    
    <!-- Payload Array -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Restrictions Payload Domain -->
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.disablemediasharing.restrictions</string>
            <key>PayloadUUID</key>
            <string>456789AB-CDEF-0123-4567-89ABCDEF0123</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Restrictions Payload</string>
            
            <!-- Target Key Settings -->
            <key>allowMediaSharing</key>
            <false/>
            <key>allowMediaSharingModification</key>
            <false/>
        </dict>
    </array>
</dict>
</plist>
