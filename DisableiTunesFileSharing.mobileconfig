<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadIdentifier</key>
    <string>com.custom.disableitunesfilesharing</string>
    <key>PayloadUUID</key>
    <string>F8A2D3C1-4B5E-6789-0123-456789ABCDEF</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Disable iTunes File Sharing</string>
    <key>PayloadDescription</key>
    <string>Disables iTunes and Finder application file sharing services on macOS.</string>
    <key>PayloadOrganization</key>
    <string>Custom IT</string>
    
    <!-- Profile Scope -->
    <key>PayloadScope</key>
    <string>System</string>
    
    <!-- Payload Array -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Restrictions Payload Domain -->
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.disableitunesfilesharing.restrictions</string>
            <key>PayloadUUID</key>
            <string>98765432-FEDC-BA09-8765-43210FEDCBA9</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Restrictions Payload</string>
            
            <!-- Target Key Setting -->
            <key>allowiTunesFileSharing</key>
            <false/>
        </dict>
    </array>
</dict>
</plist>
