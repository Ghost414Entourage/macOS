<plist version="1.0">
<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadIdentifier</key>
    <string>com.custom.imessage.settings</string>
    <key>PayloadUUID</key>
    <string>F9E8D7C6-B5A4-4321-0987-654321FEDCBA</string>
