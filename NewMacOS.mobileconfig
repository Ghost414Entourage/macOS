    <!-- Top-Level Profile Metadata -->
    <key>ConsentText</key>
    <dict>
        <key>default</key>
        <string>THE SOFTWARE IS PROVIDED 'AS IS' WITHOUT ANY WARRANTY.</string>
    </dict>
    <key>PayloadDisplayName</key>
    <string>Combined Security, Privacy Restrictions, and Application Controls</string>
    <key>PayloadDescription</key>
    <string>Disables remote screen observation, Apple personalized advertising, activity continuation (Handoff), diagnostic submissions, Siri/Assistant, forces AirDrop to be unmanaged, limits ad tracking, sets rating region to US, forces on-device only dictation, disables Apple Intelligence Report, disables incoming AirPlay requests, disables Siri audio donations for Accessibility, disables content caching, disables media sharing, disables Apple Intelligence features, disables iTunes file sharing, disables Live Voicemail, disables Apple Music Service, disables ARD remote management modifications, restricts media sharing modifications, restricts Remote Apple Events modifications, disables Universal Control, restricts iPhone Mirroring, opts out of Siri Data Sharing, configures System Policy Control settings, restricts AirDrop, disables external intelligence integrations, configures macOS Application Firewall settings, and enforces STIG application access rules.</string>
    <key>PayloadIdentifier</key>
    <string>com.company.profile.securityrestrictions.v31</string>
    <key>PayloadOrganization</key>
    <string>macOS Security Compliance Project / Custom IT</string>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>2B3C4D5E-6F7A-8901-BCDE-F234567890AB</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

