<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadIdentifier</key>
    <string>com.custom.disableairplayincoming</string>
    <key>PayloadUUID</key>
    <string>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Disable Incoming AirPlay Requests</string>
    <key>PayloadDescription</key>
    <string>Disables incoming AirPlay requests on macOS and tvOS devices.</string>
    <key>PayloadOrganization</key>
    <string>Custom IT</string>
    
    <!-- Profile Scope -->
    <key>PayloadScope</key>
    <string>System</string>
    
    <!-- Payload Array -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Preference Domain Restrictions Payload -->
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.disableairplayincoming.restrictions</string>
            <key>PayloadUUID</key>
            <string>12345678-ABCD-EF12-3456-7890ABCDEF12</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Restrictions Payload</string>
            
            <!-- Target Key Setting -->
            <key>allowAirPlayIncomingRequests</key>
            <false/>
        </dict>
    </array>
</dict>
</plist>
