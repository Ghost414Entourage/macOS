<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Profile Metadata -->
	<key>PayloadIdentifier</key>
	<string>com.organization.firewall.profile</string>
	<key>PayloadUUID</key>
	<string>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadDisplayName</key>
	<string>macOS Application Firewall Custom Profile</string>
	<key>PayloadDescription</key>
	<string>Enables stealth mode, blocks all incoming connections, and explicitly sets rules for specified system binaries and services.</string>
	<key>PayloadOrganization</key>
	<string>Your Organization</string>
	<key>PayloadScope</key>
	<string>System</string>

	<!-- Payload Content Array -->
	<key>PayloadContent</key>
	<array>
		<dict>
			<!-- Payload Metadata -->
			<key>PayloadIdentifier</key>
			<string>com.organization.firewall.payload</string>
			<key>PayloadUUID</key>
			<string>12345678-ABCD-EF12-3456-7890ABCDEF12</string>
			<key>PayloadType</key>
			<string>com.apple.security.firewall</string>
			<key>PayloadVersion</key>
			<integer>1</integer>

			<!-- Primary Restrictions -->
			<key>EnableFirewall</key>
			<true/>
			<key>BlockAllIncoming</key>
			<true/>
			<key>EnableStealthMode</key>
			<true/>

			<!-- Signed Code Behavior -->
			<key>AllowSigned</key>
			<false/>
			<key>AllowSignedApp</key>
			<false/>

			<!-- Specific Application Rules -->
			<key>Applications</key>
			<array>
				<!-- 1. remotepairingdeviced -->
				<dict>
					<key>BundleID</key>
					<string>com.apple.remotepairingdeviced</string>
					<key>Allowed</key>
					<false/>
				</dict>
				<!-- 2. remoted -->
				<dict>
					<key>BundleID</key>
					<string>com.apple.remoted</string>
					<key>Allowed</key>
					<false/>
				</dict>
				<!-- 3. python3 -->
				<dict>
					<key>BundleID</key>
					<string>com.apple.python3</string>
					<key>Allowed</key>
					<false/>
				</dict>
				<!-- 4. ruby -->
				<dict>
					<key>BundleID</key>
					<string>com.apple.ruby</string>
					<key>Allowed</key>
					<false/>
				</dict>
				<!-- 5. cupsd (Print Server) -->
				<dict>
					<key>BundleID</key>
					<string>org.cups.cupsd</string>
					<key>Allowed</key>
					<false/>
				</dict>
				<!-- 6. sharingd (AirDrop/Sharing) -->
				<dict>
					<key>BundleID</key>
					<string>com.apple.sharingd</string>
					<key>Allowed</key>
					<false/>
				</dict>
				<!-- 7. sshd-keygen-wrapper (SSH) -->
				<dict>
					<key>BundleID</key>
					<string>com.apple.sshd-keygen-wrapper</string>
					<key>Allowed</key>
					<false/>
				</dict>
				<!-- 8. smbd (Samba File Sharing) -->
				<dict>
					<key>BundleID</key>
					<string>com.apple.smbd</string>
					<key>Allowed</key>
					<false/>
				</dict>
			</array>
		</dict>
	</array>
</plist>
