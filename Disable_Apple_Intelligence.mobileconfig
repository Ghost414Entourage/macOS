<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadIdentifier</key>
    <string>com.custom.disableappleintelligencereport</string>
    <key>PayloadUUID</key>
    <string>F9E8D7C6-5432-1098-7654-3210FEDCBA98</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Disable Apple Intelligence Report</string>
    <key>PayloadDescription</key>
    <string>Disables Apple Intelligence reporting and activity export.</string>
    <key>PayloadOrganization</key>
    <string>Custom IT</string>
    
    <!-- Profile Scope -->
    <key>PayloadScope</key>
    <string>System</string>
    
    <!-- Payload Array -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Restrictions Payload Domain -->
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.disableappleintelligencereport.restrictions</string>
            <key>PayloadUUID</key>
            <string>B2C3D4E5-F6A7-8901-2345-67890ABCDEF1</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Restrictions</string>
            
            <!-- Target Key Setting -->
            <!-- Disables generating or exporting Apple Intelligence Reports -->
            <key>allowAppleIntelligenceReport</key>
            <false/>
        </dict>
    </array>
</dict>
</plist>
