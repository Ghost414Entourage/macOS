<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Top-Level Profile Metadata -->
    <key>PayloadIdentifier</key>
    <string>com.custom.intelligence.settings</string>
    <key>PayloadUUID</key>
    <string>C9A8B7C6-D5E4-3F21-0987-654321FEDCBA</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadDisplayName</key>
    <string>Disable Apple Intelligence Features</string>
    <key>PayloadDescription</key>
    <string>Disables Apple Intelligence reports, Genmoji, Image Playground, Writing Tools, and related AI capabilities.</string>
    <key>PayloadOrganization</key>
    <string>Custom IT</string>
    
    <!-- Profile Scope -->
    <key>PayloadScope</key>
    <string>System</string>
    
    <!-- Payload Array -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Intelligence Settings Payload Domain -->
            <key>PayloadType</key>
            <string>com.apple.intelligence.settings</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.intelligence.settings.payload</string>
            <key>PayloadUUID</key>
            <string>12345678-ABCD-EF01-2345-67890ABCDEF0</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>Intelligence Settings</string>
            
            <!-- Target Key Settings -->
            <key>AllowAppleIntelligenceReport</key>
            <false/>
            
            <key>AllowGenmoji</key>
            <false/>
            
            <key>AllowImagePlayground</key>
            <false/>
            
            <key>AllowImageWand</key>
            <false/>
            
            <key>AllowPersonalizedHandwritingResults</key>
            <false/>
            
            <key>AllowVisualIntelligenceSummary</key>
            <false/>
            
            <key>AllowWritingTools</key>
            <false/>
            
            <key>ForceOnDeviceOnlyDictation</key>
            <true/>
            
            <key>ForceOnDeviceOnlyTranslation</key>
            <true/>
        </dict>
    </array>
</dict>
</plist>
