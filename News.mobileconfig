<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Apple News Restriction Payload -->
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.example.news.payload</string>
            <key>PayloadUUID</key>
            <string>3F4E5D6C-7B8A-9F0E-1D2C-3B4A5F6E7D8C</string>
            <key>PayloadDisplayName</key>
            <string>Apple News Restriction</string>
            <key>PayloadDescription</key>
            <string>Disables Apple News on macOS/iOS.</string>
            
            <!-- Key Configuration -->
            <key>allowNews</key>
            <false/>
        </dict>
    </array>
    
    <!-- Top-Level Profile Metadata -->
    <key>PayloadScope</key>
    <string>System</string>
    
    <key>PayloadDisplayName</key>
    <string>Disable Apple News</string>
    <key>PayloadIdentifier</key>
    <string>com.example.news.profile</string>
    <key>PayloadUUID</key>
    <string>9B8A7C6D-5E4F-3A2B-1C0D-9E8F7A6B5C4D</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadOrganization</key>
    <string>Your Organization</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
</dict>
</plist>
